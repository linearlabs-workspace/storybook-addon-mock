{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "lib": ["ES2020", "DOM"],
        "jsx": "react",
        "declaration": true,
        "strict": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "outDir": "dist/ts",
        "rootDir": "src"
    },
    "include": ["src"],
    "exclude": ["src/**/*.test.ts", "dist", "node_modules"]
}
